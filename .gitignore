# Secrets — never commit
.env
.env.*
*.key
*.pem

# Corpus documents stay local (public repo; payer terms of use). Manifests are committed.
corpus/policies/**
!corpus/policies/manifest.yaml
!corpus/policies/README.md
corpus/programs/**
!corpus/programs/manifest.yaml
!corpus/programs/README.md

# Generated indexes, logs, uploads
index/
*.sqlite
*.db
governance/audit/
governance/requested_plans.jsonl
uploads/
tmp/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/

# OS / editor
.DS_Store
.vscode/
.idea/

# Eval output (regenerated every run)
evals/last_run.json
